		parameterValues = {
			// Canonical MOMoT qualified parameter names: Module.Unit.Parameter
			"HenshinDSL.CreateThenInsertContainerThenPopulate.k" : new RandomAtomicKindLiteralValue
			"HenshinDSL.CreateThenInsertContainerThenPopulate.cnd" : new RandomConditionKindLiteralValue

			"statement_insertions_henshin_text.CreateThenInsertContainerThenPopulate.k" : new RandomAtomicKindLiteralValue
