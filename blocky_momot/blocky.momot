			"statement_insertions_atomic_only::PopulateAnyEmptyContainer::k" : new RandomAtomicKindLiteralValue
			"statement_insertions_atomic_only::PopulateAnyEmptyContainer::cnd" : new RandomConditionKindLiteralValue
			"statement_insertions_atomic_only::HenshinDSL::PopulateAnyEmptyContainer::k" : new RandomAtomicKindLiteralValue
			"statement_insertions_atomic_only::HenshinDSL::PopulateAnyEmptyContainer::cnd" : new RandomConditionKindLiteralValue
		}
	}
	fitness = new EnumParamPreprocessFitnessFunction {
		objectives = {
			GoalReached : maximize {
				try {
					val game = root as Game
					val level = if (game.levels.isEmpty) null else game.levels.get(0)
					val status = if (level == null) GameStatus.CRASHED else BlockySimulator.run(level)
					val v = if (status == GameStatus.WON) 1.0 else 0.0
					if (Double.isFinite(v)) v else 0.0
				} catch (Throwable t) {
					0.0
				}
			}
			Edits : minimize {
				try {
					val v = BlockyProgramDistance.distanceToBaseline(root as Game) as double
					if (Double.isFinite(v)) v else 1000000000.0
				} catch (Throwable t) {
					1000000000.0
				}
			}
			ShortestPath : minimize {
				try {
					val game = root as Game
					val level = if (game.levels.isEmpty) null else game.levels.get(0)
					val v = if (level == null) 100000.0 else {
						val d = BlockySimulator.distanceToGoalOrPenalty(level) as double
						if (d > 0.0) {
							1000.0 + d
						} else {
							BlockySimulator.stepsToGoalOrPenalty(level) as double
						}
					}
					if (Double.isFinite(v)) v else 1000000.0
				} catch (Throwable t) {
					1000000.0
				}
			}
			closestToGoal : minimize {
				try {
					val game = root as Game
					val level = if (game.levels.isEmpty) null else game.levels.get(0)
					val v = (if (level == null) 100000.0 else BlockySimulator.closestToGoalOrPenalty(level, 100000) as double)
					if (Double.isFinite(v)) v else 1000000000.0
				} catch (Throwable t) {
					1000000000.0
				}
			}
//			DistanceToGoal : minimize {
//				try {
