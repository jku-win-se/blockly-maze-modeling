		// IMPORTANT:
		// We model some requirements as *penalty objectives* instead of constraints.
		// MOMoT/ MOEA marks infeasible individuals by setting other objectives to Infinity.
		solutionRepairer = new TransformationPlaceholderRepairer
	}
	algorithms = {
		// Start with Random to sanity-check rule applicability quickly.
